#else
import ${voPackage}.${voClassName};
#end

/**
 * @Class Name : ${serviceClassName}.java
 * @Description : ${model.entity.pcName} Business class
 * @Modification Information
 *
 * @author ${author}
 * @since ${createDate}
 * @version 1.0
 * @see
