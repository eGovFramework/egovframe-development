<?xml version="1.0" encoding="UTF-8"?>
<EclipseWork>
    <wizard>
        <title>New Cache</title>

        <component-page required="true">
        	<!-- NewCache	New Cache -->
            <description>Set Default Cache.</description>

			<group label="Generation File" required="true" >
				<container name="txtPath" label="File Path: " required="true" type="folder" value="#webroot" />
	            <textfield name="txtFileName" label="File Name:" required="true" value="ehcache-default"/>
            </group>
            <group label="Disk Store" required="true" >
            	<textfield name="txtDiskStore" label="Disk Store Path: " required="true" value="user.dir/second"/>
            </group>
            <group label="Default Cache" required="true" >
	            <radio name="txtDftEternal" label="Eternal: " required="true" value="false" listener="true">
	            	<elements>
	            		<option>true</option>
	            		<option>false</option>
	            	</elements>
	            </radio>
	            <textfield name="txtDftLiveTime" label="Live Time (min): " required="false" value="10" radio="false"/>
	            <textfield name="txtDftHeapEntries" label="Heap Entries: " required="false" value="100"/>
	            <textfield name="txtDftOffheapSize" label="OffHeap Size (MB): " required="false" value=""/>
	            <combo name="txtDftDiskPersistence" label="Use Disk Storage: " required="false" value="true">
	            	<elements>
	            		<option>true</option>
	            		<option>false</option>
	            	</elements>
	            </combo>
            </group>
        </component-page>

		<component-page required="true">
			<!-- NewCacheCustom	New Cache Custom -->
			<description>Set Custom Cache.</description>
			<group label="Custom Cache" required="true" >
				<textfield name="txtCacheName" label="Cache Name: " required="true" value="cache" />
	            <radio name="txtEternal" label="Eternal: " required="true" value="false" listener="true">
	            	<elements>
	            		<option>true</option>
	            		<option>false</option>
	            	</elements>
	            </radio>
	            <textfield name="txtIdleTime" label="Idle Time (sec): " required="false" value="300" radio="false"/>
	            <textfield name="txtHeapEntries" label="Heap Entries: " required="false" value="10"/>
	        </group>
		</component-page>

        <output>
            <template component="txtFileName"  velocity="cache.vm" extension="xml" container="txtPath"/>
        </output>
    </wizard>
</EclipseWork>
