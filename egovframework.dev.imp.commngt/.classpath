<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="src" path="src"/>
	<classpathentry exported="true" kind="lib" path="lib/ant-1.6.1.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/commons-io-1.3.2.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jdom.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/poi-3.2-FINAL.jar"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
